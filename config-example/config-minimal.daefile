global {
  tproxy_port: 15080
  log_level: info
}

interface {
  wan_interface: auto
  # lan_interface: eth1 docker0
  # bind_interface: auto
}

outbounds {
  nodes {
    main {
      protocol: shadowsocks
      address: 192.168.12.1:9697
      cipher: aes-128-gcm
      password: password123
      dial_timeout_ms: 5000
    }
  }
  groups {
    proxy {
      policy: fixed
      nodes(main)
    }
  }
}

routing {
  fallback: proxy(proxy)
}

dns {
  starting_dns {
    ip_version_prefer: 4
    upstream: ['udp://223.5.5.5:53', 'udp://1.1.1.1:53']
  }
  bind: '127.0.0.1:5353'
  groups {
    default_dns {
      send_by: proxy
      query_mode: concurrent
      upstream {
        cloudflare: 'udp://1.1.1.1:53'
      }
    }
  }
  routing {
    fallback: default_dns
  }
}
