global {
  tproxy_port: 15080
  log_level: info
}

interface {
  wan_interface: auto
  # lan_interface: eth1 docker0
  # bind_interface: auto
}

outbounds {
  nodes {
    main {
      protocol: shadowsocks
      address: 192.168.12.1:9697
      cipher: aes-128-gcm
      password: password123
      dial_timeout_ms: 5000
    }
    fallback {
      protocol: socks5
      address: 192.168.12.1:9696
      dial_timeout_ms: 5000
    }
  }
  groups {
    proxy {
      policy: min_avg10
      nodes(regex: '.*')
    }
  }
}

rule_set {
  # Surge-format text lists to bypass mainland-China traffic (both mihomo and
  # Surge formats are supported by the parser).
  chinadomain {
    type: domain_list            # domains that should be accessed directly (mostly China)
    url: 'https://cdn.jsdelivr.net/gh/Loyalsoldier/surge-rules@release/direct.txt'
    name: chinadomain            # referenced by set:chinadomain
    update: time: 04:30          # update daily at 04:30
    update_on_start: true
  }

  chinaip {
    type: ip_list                # mainland-China IP/CIDR list
    url: 'https://cdn.jsdelivr.net/gh/Loyalsoldier/geoip@release/surge/cn.txt'
    name: chinaip                # referenced by set:chinaip
    update: period: 1d           # update once per day
    update_on_start: true
    proxy: proxy                 # download through the proxy group
  }
}

routing {
  target_domain(set:chinadomain) -> direct   # domains in the direct list → direct
  target_ip(set:chinaip) -> direct           # mainland-China IPs → direct
  fallback: proxy(proxy)                     # everything else → proxy
}

