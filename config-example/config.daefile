global {
  tproxy_port: 15080
  log_level: info
}

interface {
  # auto: follow the interface(s) carrying the default route (IPv4+IPv6)
  wan_interface: auto
  # glob patterns are supported: wan_interface: eth* enp?*
  # regex patterns are supported: wan_interface: regex('^enp[0-9]+$')
  # lan_interface: eth1 docker0
  # bind_interface: auto
}

process_exclusion {
  enabled: true
  protect_self: true
  protect_children: true
  gc_interval_sec: 30
  stale_after_sec: 120

  match {
    comm(dae-rs, naiveproxy)
    #pid(1234)
    #tgid(1234)
  }
}

outbounds {
  nodes {
    # ── SOCKS5 ──
    socks5_node {
      protocol: socks5
      address: 127.0.0.1:1080
      #username: user
      #password: pass
      dial_timeout_ms: 5000
    }
    # socks5_import {
    #   import: 'socks5://127.0.0.1:2080'
    # }

    # ── Shadowsocks ──
    # 2022 Edition (Recommended)
    ss2022_node {
      protocol: shadowsocks
      address: server.example.com:8388
      cipher: 2022-blake3-aes-256-gcm
      password: your-psk-here
      dial_timeout_ms: 5000
    }
    # AEAD (Legacy)
    ss_aead_node {
      protocol: shadowsocks
      address: server.example.com:8388
      cipher: aes-256-gcm
      password: your-password
      dial_timeout_ms: 5000
    }
    # ss_import {
    #   import: 'ss://2022-blake3-aes-256-gcm:password@server.example.com:8388'
    # }

    # ── Trojan ──
    trojan_node {
      protocol: trojan
      address: server.example.com:443
      password: your-password
      sni: server.example.com
      # ca_sha256: "fb3a01e4..." # Pin certificate SHA256 fingerprint
      dial_timeout_ms: 5000
    }
    # trojan_import {
    #   import: 'trojan://password@server.example.com:443?sni=example.com'
    # }

    # ── TUIC v5 (compatible with mihomo) ──
    tuic_node {
      protocol: tuic
      address: server.example.com:443
      uuid: d0529668-8835-11ec-a8a3-0242ac120002
      password: your-password
      congestion_control: bbr
      alpn: h3
      sni: server.example.com
      # ca_sha256: "fb3a01e4..." # Pin certificate SHA256 fingerprint
      dial_timeout_ms: 5000
    }
    # tuic_import {
    #   import: 'tuic://uuid:password@server.example.com:443?congestion_control=bbr&alpn=h3'
    # }

    # ── Juicity ──
    juicity_node {
      protocol: juicity
      address: server.example.com:443
      uuid: d0529668-8835-11ec-a8a3-0242ac120002
      password: your-password
      sni: server.example.com
      # ca_sha256: "fb3a01e4..." # Pin certificate SHA256 fingerprint
      dial_timeout_ms: 5000
    }
    # juicity_import {
    #   import: 'juicity://uuid:password@server.example.com:443'
    # }

    # ── VMess (AEAD authentication) ──
    # TCP transport (default)
    vmess_tcp_node {
      protocol: vmess
      address: server.example.com:443
      uuid: d0529668-8835-11ec-a8a3-0242ac120002
      security: auto  # auto | aes-128-gcm | chacha20-poly1305 | none
      alter_id: 0
      sni: server.example.com
      # ca_sha256: "fb3a01e4..." # Pin certificate SHA256 fingerprint
      dial_timeout_ms: 5000
    }
    # WebSocket transport
    vmess_ws_node {
      protocol: vmess
      address: server.example.com:80
      uuid: d0529668-8835-11ec-a8a3-0242ac120002
      security: none
      alter_id: 0
      network: ws
      ws_path: /ws
      ws_headers: { "Host": "example.com" }
      dial_timeout_ms: 5000
    }
    # WebSocket + TLS transport (WSS)
    vmess_ws_tls_node {
      protocol: vmess
      address: server.example.com:443
      uuid: d0529668-8835-11ec-a8a3-0242ac120002
      security: none  # Use TLS instead of VMess encryption
      alter_id: 0
      network: ws
      ws_path: /ws
      ws_headers: { "Host": "example.com" }
      sni: server.example.com
      # ca_sha256: "fb3a01e4..." # Pin certificate SHA256 fingerprint
      dial_timeout_ms: 5000
    }
    # HTTP/2 transport (requires TLS)
    vmess_h2_node {
      protocol: vmess
      address: server.example.com:443
      uuid: d0529668-8835-11ec-a8a3-0242ac120002
      security: none  # Use TLS instead of VMess encryption
      alter_id: 0
      network: h2
      h2_path: /h2
      h2_host: example.com
      sni: server.example.com
      # ca_sha256: "fb3a01e4..." # Pin certificate SHA256 fingerprint
      dial_timeout_ms: 5000
    }
    # gRPC transport (requires TLS)
    vmess_grpc_node {
      protocol: vmess
      address: server.example.com:443
      uuid: d0529668-8835-11ec-a8a3-0242ac120002
      security: none  # Use TLS instead of VMess encryption
      alter_id: 0
      network: grpc
      grpc_service_name: grpc
      sni: server.example.com
      # ca_sha256: "fb3a01e4..." # Pin certificate SHA256 fingerprint
      dial_timeout_ms: 5000
    }
    # vmess_import {
    #   # Standard URI format
    #   import: 'vmess://uuid@server.example.com:443?security=auto'
    # }
    # vmess_import_base64 {
    #   # v2rayN base64 format: vmess://base64(json)
    #   import: 'vmess:'
    # }
  }

  groups {
    proxy_primary {
      # type: auto           # default, can be omitted
      # policy: fixed        # always pick first node
      # policy: random       # random node selection
      # policy: min          # pick node with lowest last probe latency
      # policy: min_avg10    # pick node with lowest avg10 latency
      policy: min_moving_avg # pick node with lowest moving average latency (recommended)
      nodes(ss2022_node, ss_aead_node, trojan_node, tuic_node, juicity_node)
    }

    a_group {
      type: auto
      policy: min_avg10
      nodes(regex: '*')
    }

    # select type: node is manually switched via REST API, no auto probing
    manual {
      type: select
      selected: socks5_node    # initial selected node, can be updated via API
      nodes(socks5_node, vmess_tcp_node, vmess_ws_node)
    }
  }
}

rule_set {
  # ── v2ray .dat 类型（Loyalsoldier 发布，真实可靠数据源）──
  geoip_main {
    type: geoip                  # GeoIP dat：按 country_code（CN/PRIVATE/...）分组
    url: 'https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat'
    name: geoip_main             # 唯一备注（缺省用块名）；供 geoip:<code> 引用
    update: time: 21:47          # 每天 21:47 更新（HH:MM，无秒）
    update_on_start: true        # 启动时无条件更新一次
  }

  geosite_main {
    type: geosite                # GeoSite dat：按分类名（cn/geolocation-!cn/...）分组
    url: 'https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat'
    name: geosite_main           # 供 geosite:<code> 引用
    update: period: 3h2m         # 每 3 小时 2 分钟更新一次（d/h/m 组合，无秒）
  }

  # ── 文本列表类型（URL 为占位示例，可按需替换为真实源）──
  chinadomain {
    type: domain_list            # 每行一条域名/域名模式（支持 suffix:/full:/keyword:/regex:）
    url: 'https://example.com/rules/chinadomain.txt'   # 占位 URL（可替换）
    name: chinadomain            # 供 set:chinadomain 引用
    update: time: 04:30          # 每天 04:30 更新
    update_on_start: false
  }

  chinaip {
    type: ip_list                # 每行一条 CIDR（a.b.c.d/nn）或裸 IP
    url: 'https://example.com/rules/chinaip.txt'       # 占位 URL（可替换）
    name: chinaip                # 供 set:chinaip 引用
    update: period: 1d           # 每 1 天更新一次
    proxy: proxy_primary         # 显式指定下载用代理组（缺省用第一个代理组）
  }
}

routing {
  # ── 规则集引用（阶段 3 新语法）──
  source_ip(set:chinaip) -> direct                    # 源 IP 命中文本 IP 列表 chinaip → 直连
  target_ip(geoip:cn) -> direct                       # 目标 IP 命中 GeoIP CN → 直连
  target_domain(geosite:cn) -> direct                 # 目标域名命中 GeoSite CN → 直连
  target_domain(set:chinadomain) -> direct            # 目标域名命中文本域名列表 → 直连
  # ── 原有示例（旧别名 dip/sip 与自由组合保留）──
  dip(geoip:private) -> direct                        # 私有网段 → 直连（数据驱动，旧语法兼容）
  dport(22) -> direct                                 # SSH 直连
  dport(80,443) && !target_ip(geoip:private) -> proxy(proxy_primary)  # 逗号多值 + && + ! 组合
  l4proto(tcp) -> proxy(proxy_primary)                # TCP 走代理
  fallback: proxy(proxy_primary)
}

dns {
  starting_dns {
    ip_version_prefer: 4
    upstream {
      bootstrap: 'udp://1.1.1.1:53'
    }
  }
  bind: '127.0.0.1:5353'
  cache {
    enabled: true
    max_size: 4096
    max_ttl: 86400
    min_ttl: 60
    optimistic_cache: true
    optimistic_cache_ttl: 3600
  }
  groups {
    trusted_dns {
      proxy: proxy_primary
      upstream {
        googledns: 'tcp+udp://dns.google:53'
        cloudflare: 'udp://1.1.1.1:53'
      }
      request_routing {
        fallback: googledns
      }
      response_routing {
        upstream(googledns) -> accept
        ip(geoip:private) && !qname(geosite:cn) -> googledns   # && 与 ! 自由组合
        ip(set:chinaip) -> googledns                           # 响应地址命中 chinaip → 换上游重查
        fallback: accept
      }
    }
    china_dns {
      proxy: direct
      upstream {
        alidns: 'udp://dns.alidns.com:53'
        cnnic: 'udp://1.2.4.8:53'
      }
      request_routing {
        fallback: alidns
      }
    }
  }
  routing {
    qname(geosite:cn) -> china_dns
    qname(set:chinadomain) -> china_dns                       # 文本域名列表引用（DNS 查询路由）
    qname(geosite:geolocation-!cn) -> trusted_dns
    fallback: trusted_dns
  }
}
