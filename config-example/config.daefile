global {
  tproxy_port: 15080
  log_level: info
}

interface {
  # auto: follow the interface(s) carrying the default route (IPv4+IPv6)
  wan_interface: auto
  # glob patterns are supported: wan_interface: eth* enp?*
  # regex patterns are supported: wan_interface: regex('^enp[0-9]+$')
  # lan_interface: eth1 docker0
  # bind_interface: auto
}

process_exclusion {
  enabled: true
  protect_self: true
  protect_children: true
  gc_interval_sec: 30
  stale_after_sec: 120

  match {
    comm(dae-rs, naiveproxy)
    #pid(1234)
    #tgid(1234)
  }
}

outbounds {
  nodes {
    # ── SOCKS5 ──
    socks5_node {
      protocol: socks5
      address: 127.0.0.1:1080
      #username: user
      #password: pass
      dial_timeout_ms: 5000
    }
    # socks5_import {
    #   import: 'socks5://127.0.0.1:2080'
    # }

    # ── Shadowsocks ──
    # 2022 Edition (Recommended)
    ss2022_node {
      protocol: shadowsocks
      address: server.example.com:8388
      cipher: 2022-blake3-aes-256-gcm
      password: your-psk-here
      dial_timeout_ms: 5000
    }
    # AEAD (Legacy)
    ss_aead_node {
      protocol: shadowsocks
      address: server.example.com:8388
      cipher: aes-256-gcm
      password: your-password
      dial_timeout_ms: 5000
    }
    # ss_import {
    #   import: 'ss://2022-blake3-aes-256-gcm:password@server.example.com:8388'
    # }

    # ── Trojan ──
    trojan_node {
      protocol: trojan
      address: server.example.com:443
      password: your-password
      sni: server.example.com
      # ca_sha256: "fb3a01e4..." # Pin certificate SHA256 fingerprint
      dial_timeout_ms: 5000
    }
    # trojan_import {
    #   import: 'trojan://password@server.example.com:443?sni=example.com'
    # }

    # ── TUIC v5 (compatible with mihomo) ──
    tuic_node {
      protocol: tuic
      address: server.example.com:443
      uuid: d0529668-8835-11ec-a8a3-0242ac120002
      password: your-password
      congestion_control: bbr
      alpn: h3
      sni: server.example.com
      # ca_sha256: "fb3a01e4..." # Pin certificate SHA256 fingerprint
      dial_timeout_ms: 5000
    }
    # tuic_import {
    #   import: 'tuic://uuid:password@server.example.com:443?congestion_control=bbr&alpn=h3'
    # }

    # ── Juicity ──
    juicity_node {
      protocol: juicity
      address: server.example.com:443
      uuid: d0529668-8835-11ec-a8a3-0242ac120002
      password: your-password
      sni: server.example.com
      # ca_sha256: "fb3a01e4..." # Pin certificate SHA256 fingerprint
      dial_timeout_ms: 5000
    }
    # juicity_import {
    #   import: 'juicity://uuid:password@server.example.com:443'
    # }

    # ── VMess (AEAD authentication) ──
    # TCP transport (default)
    vmess_tcp_node {
      protocol: vmess
      address: server.example.com:443
      uuid: d0529668-8835-11ec-a8a3-0242ac120002
      security: auto  # auto | aes-128-gcm | chacha20-poly1305 | none
      alter_id: 0
      sni: server.example.com
      # ca_sha256: "fb3a01e4..." # Pin certificate SHA256 fingerprint
      dial_timeout_ms: 5000
    }
    # WebSocket transport
    vmess_ws_node {
      protocol: vmess
      address: server.example.com:80
      uuid: d0529668-8835-11ec-a8a3-0242ac120002
      security: none
      alter_id: 0
      network: ws
      ws_path: /ws
      ws_headers: { "Host": "example.com" }
      dial_timeout_ms: 5000
    }
    # WebSocket + TLS transport (WSS)
    vmess_ws_tls_node {
      protocol: vmess
      address: server.example.com:443
      uuid: d0529668-8835-11ec-a8a3-0242ac120002
      security: none  # Use TLS instead of VMess encryption
      alter_id: 0
      network: ws
      ws_path: /ws
      ws_headers: { "Host": "example.com" }
      sni: server.example.com
      # ca_sha256: "fb3a01e4..." # Pin certificate SHA256 fingerprint
      dial_timeout_ms: 5000
    }
    # HTTP/2 transport (requires TLS)
    vmess_h2_node {
      protocol: vmess
      address: server.example.com:443
      uuid: d0529668-8835-11ec-a8a3-0242ac120002
      security: none  # Use TLS instead of VMess encryption
      alter_id: 0
      network: h2
      h2_path: /h2
      h2_host: example.com
      sni: server.example.com
      # ca_sha256: "fb3a01e4..." # Pin certificate SHA256 fingerprint
      dial_timeout_ms: 5000
    }
    # gRPC transport (requires TLS)
    vmess_grpc_node {
      protocol: vmess
      address: server.example.com:443
      uuid: d0529668-8835-11ec-a8a3-0242ac120002
      security: none  # Use TLS instead of VMess encryption
      alter_id: 0
      network: grpc
      grpc_service_name: grpc
      sni: server.example.com
      # ca_sha256: "fb3a01e4..." # Pin certificate SHA256 fingerprint
      dial_timeout_ms: 5000
    }
    # vmess_import {
    #   # Standard URI format
    #   import: 'vmess://uuid@server.example.com:443?security=auto'
    # }
    # vmess_import_base64 {
    #   # v2rayN base64 format: vmess://base64(json)
    #   import: 'vmess:'
    # }
  }

  groups {
    proxy_primary {
      # type: auto           # default, can be omitted
      # policy: fixed        # always pick first node
      # policy: random       # random node selection
      # policy: min          # pick node with lowest last probe latency
      # policy: min_avg10    # pick node with lowest avg10 latency
      policy: min_moving_avg # pick node with lowest moving average latency (recommended)
      nodes(ss2022_node, ss_aead_node, trojan_node, tuic_node, juicity_node)
    }

    a_group {
      type: auto
      policy: min_avg10
      nodes(regex: '.*')
    }

    # select type: node is manually switched via REST API, no auto probing
    manual {
      type: select
      selected: socks5_node    # initial selected node, can be updated via API
      nodes(socks5_node, vmess_tcp_node, vmess_ws_node)
    }
  }
}

rule_set {
  # ── Text list types (Surge-format sources; both mihomo and Surge formats are supported) ──
  chinadomain {
    type: domain_list            # one domain / domain pattern per line (supports mihomo & Surge DOMAIN-* rules)
    url: 'https://cdn.jsdelivr.net/gh/Loyalsoldier/surge-rules@release/direct.txt'   # Surge-format domain list
    name: chinadomain            # referenced by set:chinadomain
    update: time: 04:30          # update daily at 04:30
    update_on_start: false
  }

  chinaip {
    type: ip_list                # one CIDR per line (supports mihomo & Surge IP-CIDR rules)
    url: 'https://cdn.jsdelivr.net/gh/Loyalsoldier/geoip@release/surge/cn.txt'       # Surge-format IP list
    name: chinaip                # referenced by set:chinaip
    update: period: 1d           # update once per day
    proxy: proxy_primary         # explicit proxy group for downloads (defaults to the first proxy group)
  }
}

routing {
  source_ip(set:chinaip) -> direct                    # source IP hits text IP list chinaip → direct
  target_domain(set:chinadomain) -> direct            # target domain hits text domain list → direct
  dport(22) -> direct                                 # SSH → direct
  dport(80,443) -> proxy(proxy_primary)              # HTTP/HTTPS → proxy
  l4proto(tcp) -> proxy(proxy_primary)                # TCP → proxy
  fallback: proxy(proxy_primary)
}

