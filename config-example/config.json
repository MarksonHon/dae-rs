{
  "version": 1,
  "runtime": {
    "tproxy_port": 15080,
    "log_level": "info",
    "temp_json": true
  },
  "interface": {
    "wan_interface": [
      "auto"
    ],
    "lan_interface": []
  },
  "process_exclusion": {
    "enabled": true,
    "protect_self": true,
    "protect_children": true,
    "gc_interval_sec": 30,
    "stale_after_sec": 120,
    "match": {
      "comm": [
        "dae-rs",
        "naiveproxy"
      ]
    }
  },
  "outbounds": {
    "nodes": [
      {
        "name": "socks5_node",
        "protocol": "socks5",
        "address": "127.0.0.1:1080",
        "dial_timeout_ms": 5000
      },
      {
        "name": "ss2022_node",
        "protocol": "shadowsocks",
        "address": "server.example.com:8388",
        "password": "your-psk-here",
        "cipher": "2022-blake3-aes-256-gcm",
        "dial_timeout_ms": 5000
      },
      {
        "name": "ss_aead_node",
        "protocol": "shadowsocks",
        "address": "server.example.com:8388",
        "password": "your-password",
        "cipher": "aes-256-gcm",
        "dial_timeout_ms": 5000
      },
      {
        "name": "trojan_node",
        "protocol": "trojan",
        "address": "server.example.com:443",
        "password": "your-password",
        "sni": "server.example.com",
        "dial_timeout_ms": 5000
      },
      {
        "name": "tuic_node",
        "protocol": "tuic",
        "address": "server.example.com:443",
        "password": "your-password",
        "sni": "server.example.com",
        "uuid": "d0529668-8835-11ec-a8a3-0242ac120002",
        "congestion_control": "bbr",
        "alpn": [
          "h3"
        ],
        "dial_timeout_ms": 5000
      },
      {
        "name": "juicity_node",
        "protocol": "juicity",
        "address": "server.example.com:443",
        "password": "your-password",
        "sni": "server.example.com",
        "uuid": "d0529668-8835-11ec-a8a3-0242ac120002",
        "dial_timeout_ms": 5000
      },
      {
        "name": "vmess_tcp_node",
        "protocol": "vmess",
        "address": "server.example.com:443",
        "sni": "server.example.com",
        "uuid": "d0529668-8835-11ec-a8a3-0242ac120002",
        "security": "auto",
        "alter_id": 0,
        "dial_timeout_ms": 5000
      },
      {
        "name": "vmess_ws_node",
        "protocol": "vmess",
        "address": "server.example.com:80",
        "uuid": "d0529668-8835-11ec-a8a3-0242ac120002",
        "security": "none",
        "alter_id": 0,
        "network": "ws",
        "ws_path": "/ws",
        "ws_headers": {
          "Host": "example.com"
        },
        "dial_timeout_ms": 5000
      },
      {
        "name": "vmess_ws_tls_node",
        "protocol": "vmess",
        "address": "server.example.com:443",
        "sni": "server.example.com",
        "uuid": "d0529668-8835-11ec-a8a3-0242ac120002",
        "security": "none",
        "alter_id": 0,
        "network": "ws",
        "ws_path": "/ws",
        "ws_headers": {
          "Host": "example.com"
        },
        "dial_timeout_ms": 5000
      },
      {
        "name": "vmess_h2_node",
        "protocol": "vmess",
        "address": "server.example.com:443",
        "sni": "server.example.com",
        "uuid": "d0529668-8835-11ec-a8a3-0242ac120002",
        "security": "none",
        "alter_id": 0,
        "network": "h2",
        "h2_path": "/h2",
        "h2_host": "example.com",
        "dial_timeout_ms": 5000
      },
      {
        "name": "vmess_grpc_node",
        "protocol": "vmess",
        "address": "server.example.com:443",
        "sni": "server.example.com",
        "uuid": "d0529668-8835-11ec-a8a3-0242ac120002",
        "security": "none",
        "alter_id": 0,
        "network": "grpc",
        "grpc_service_name": "grpc",
        "dial_timeout_ms": 5000
      }
    ],
    "groups": [
      {
        "name": "proxy_primary",
        "group_type": "auto",
        "policy": "min_moving_avg",
        "selectors": [
          {
            "type": "list",
            "nodes": [
              "ss2022_node",
              "ss_aead_node",
              "trojan_node",
              "tuic_node",
              "juicity_node"
            ]
          }
        ]
      },
      {
        "name": "a_group",
        "group_type": "auto",
        "policy": "min_avg10",
        "selectors": [
          {
            "type": "regex",
            "pattern": "*"
          }
        ]
      },
      {
        "name": "manual",
        "group_type": "select",
        "selected": "socks5_node",
        "selectors": [
          {
            "type": "list",
            "nodes": [
              "socks5_node",
              "vmess_tcp_node",
              "vmess_ws_node"
            ]
          }
        ]
      }
    ]
  },
  "rule_set": {
    "geoip_main": {
      "type": "geoip",
      "url": "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat",
      "name": "geoip_main",
      "update": {
        "time": "21:47"
      },
      "update_on_start": true
    },
    "geosite_main": {
      "type": "geosite",
      "url": "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat",
      "name": "geosite_main",
      "update": {
        "period": "3h2m"
      }
    },
    "chinadomain": {
      "type": "domain_list",
      "url": "https://example.com/rules/chinadomain.txt",
      "name": "chinadomain",
      "update": {
        "time": "04:30"
      },
      "update_on_start": false
    },
    "chinaip": {
      "type": "ip_list",
      "url": "https://example.com/rules/chinaip.txt",
      "name": "chinaip",
      "update": {
        "period": "1d"
      },
      "proxy": "proxy_primary"
    }
  },
  "routing": {
    "rules": [
      {
        "match": "source_ip(set:chinaip)",
        "action": "direct"
      },
      {
        "match": "target_ip(geoip:cn)",
        "action": "direct"
      },
      {
        "match": "target_domain(geosite:cn)",
        "action": "direct"
      },
      {
        "match": "target_domain(set:chinadomain)",
        "action": "direct"
      },
      {
        "match": "dip(geoip:private)",
        "action": "direct"
      },
      {
        "match": "dport(22)",
        "action": "direct"
      },
      {
        "match": "dport(80,443) && !target_ip(geoip:private)",
        "action": "proxy(proxy_primary)"
      },
      {
        "match": "l4proto(tcp)",
        "action": "proxy(proxy_primary)"
      }
    ],
    "fallback": "proxy(proxy_primary)"
  },
  "dns": {
    "starting_dns": {
      "ip_version_prefer": 4,
      "upstream": [
        {
          "label": "bootstrap",
          "address": "udp://1.1.1.1:53"
        },
        {
          "label": "bootstrap",
          "address": "udp://1.1.1.1:53"
        }
      ]
    },
    "bind": "127.0.0.1:5353",
    "cache": {
      "enabled": true,
      "max_size": 4096,
      "max_ttl": 86400,
      "min_ttl": 60,
      "optimistic_cache": true,
      "optimistic_cache_ttl": 3600
    },
    "groups": [
      {
        "name": "trusted_dns",
        "proxy": "proxy_primary",
        "upstream": [
          {
            "label": "googledns",
            "address": "tcp+udp://dns.google:53"
          },
          {
            "label": "cloudflare",
            "address": "udp://1.1.1.1:53"
          }
        ],
        "request_routing": {
          "rules": [],
          "fallback": "googledns"
        },
        "response_routing": {
          "rules": [
            {
              "match": "upstream(googledns)",
              "action": "accept"
            },
            {
              "match": "ip(geoip:private) && !qname(geosite:cn)",
              "action": "googledns"
            },
            {
              "match": "ip(set:chinaip)",
              "action": "googledns"
            }
          ],
          "fallback": "accept"
        }
      },
      {
        "name": "china_dns",
        "proxy": "direct",
        "upstream": [
          {
            "label": "alidns",
            "address": "udp://dns.alidns.com:53"
          },
          {
            "label": "cnnic",
            "address": "udp://1.2.4.8:53"
          }
        ],
        "request_routing": {
          "rules": [],
          "fallback": "alidns"
        }
      }
    ],
    "routing": {
      "rules": [
        {
          "match": "qname(geosite:cn)",
          "action": "china_dns"
        },
        {
          "match": "qname(set:chinadomain)",
          "action": "china_dns"
        },
        {
          "match": "qname(geosite:geolocation-!cn)",
          "action": "trusted_dns"
        }
      ],
      "fallback": "trusted_dns"
    }
  }
}
