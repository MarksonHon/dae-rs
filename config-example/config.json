{
  "version": 1,
  "runtime": {
    "tproxy_port": 15080,
    "log_level": "info",
    "temp_json": true
  },
  "interface": {
    "wan_interface": [
      "auto"
    ],
    "lan_interface": []
  },
  "process_exclusion": {
    "enabled": true,
    "protect_self": true,
    "protect_children": true,
    "gc_interval_sec": 30,
    "stale_after_sec": 120,
    "match": {
      "comm": [
        "dae-rs",
        "naiveproxy"
      ]
    }
  },
  "outbounds": {
    "nodes": [
      {
        "name": "socks5_node",
        "protocol": "socks5",
        "address": "127.0.0.1:1080",
        "dial_timeout_ms": 5000
      },
      {
        "name": "ss2022_node",
        "protocol": "shadowsocks",
        "address": "server.example.com:8388",
        "password": "your-psk-here",
        "cipher": "2022-blake3-aes-256-gcm",
        "dial_timeout_ms": 5000
      },
      {
        "name": "ss_aead_node",
        "protocol": "shadowsocks",
        "address": "server.example.com:8388",
        "password": "your-password",
        "cipher": "aes-256-gcm",
        "dial_timeout_ms": 5000
      },
      {
        "name": "trojan_node",
        "protocol": "trojan",
        "address": "server.example.com:443",
        "password": "your-password",
        "sni": "server.example.com",
        "dial_timeout_ms": 5000
      },
      {
        "name": "tuic_node",
        "protocol": "tuic",
        "address": "server.example.com:443",
        "password": "your-password",
        "sni": "server.example.com",
        "uuid": "d0529668-8835-11ec-a8a3-0242ac120002",
        "congestion_control": "bbr",
        "alpn": [
          "h3"
        ],
        "dial_timeout_ms": 5000
      },
      {
        "name": "juicity_node",
        "protocol": "juicity",
        "address": "server.example.com:443",
        "password": "your-password",
        "sni": "server.example.com",
        "uuid": "d0529668-8835-11ec-a8a3-0242ac120002",
        "dial_timeout_ms": 5000
      },
      {
        "name": "vmess_tcp_node",
        "protocol": "vmess",
        "address": "server.example.com:443",
        "sni": "server.example.com",
        "uuid": "d0529668-8835-11ec-a8a3-0242ac120002",
        "security": "auto",
        "alter_id": 0,
        "dial_timeout_ms": 5000
      },
      {
        "name": "vmess_ws_node",
        "protocol": "vmess",
        "address": "server.example.com:80",
        "uuid": "d0529668-8835-11ec-a8a3-0242ac120002",
        "security": "none",
        "alter_id": 0,
        "network": "ws",
        "ws_path": "/ws",
        "ws_headers": {
          "Host": "example.com"
        },
        "dial_timeout_ms": 5000
      },
      {
        "name": "vmess_ws_tls_node",
        "protocol": "vmess",
        "address": "server.example.com:443",
        "sni": "server.example.com",
        "uuid": "d0529668-8835-11ec-a8a3-0242ac120002",
        "security": "none",
        "alter_id": 0,
        "network": "ws",
        "ws_path": "/ws",
        "ws_headers": {
          "Host": "example.com"
        },
        "dial_timeout_ms": 5000
      },
      {
        "name": "vmess_h2_node",
        "protocol": "vmess",
        "address": "server.example.com:443",
        "sni": "server.example.com",
        "uuid": "d0529668-8835-11ec-a8a3-0242ac120002",
        "security": "none",
        "alter_id": 0,
        "network": "h2",
        "h2_path": "/h2",
        "h2_host": "example.com",
        "dial_timeout_ms": 5000
      },
      {
        "name": "vmess_grpc_node",
        "protocol": "vmess",
        "address": "server.example.com:443",
        "sni": "server.example.com",
        "uuid": "d0529668-8835-11ec-a8a3-0242ac120002",
        "security": "none",
        "alter_id": 0,
        "network": "grpc",
        "grpc_service_name": "grpc",
        "dial_timeout_ms": 5000
      }
    ],
    "groups": [
      {
        "name": "proxy_primary",
        "group_type": "auto",
        "policy": "min_moving_avg",
        "selectors": [
          {
            "type": "list",
            "nodes": [
              "ss2022_node",
              "ss_aead_node",
              "trojan_node",
              "tuic_node",
              "juicity_node"
            ]
          }
        ]
      },
      {
        "name": "a_group",
        "group_type": "auto",
        "policy": "min_avg10",
        "selectors": [
          {
            "type": "regex",
            "pattern": "*"
          }
        ]
      },
      {
        "name": "manual",
        "group_type": "select",
        "selected": "socks5_node",
        "selectors": [
          {
            "type": "list",
            "nodes": [
              "socks5_node",
              "vmess_tcp_node",
              "vmess_ws_node"
            ]
          }
        ]
      }
    ]
  },
  "rule_set": {
    "chinadomain": {
      "type": "domain_list",
      "url": "https://cdn.jsdelivr.net/gh/Loyalsoldier/surge-rules@release/direct.txt",
      "name": "chinadomain",
      "update": {
        "time": "04:30"
      },
      "update_on_start": false
    },
    "chinaip": {
      "type": "ip_list",
      "url": "https://cdn.jsdelivr.net/gh/Loyalsoldier/geoip@release/surge/cn.txt",
      "name": "chinaip",
      "update": {
        "period": "1d"
      },
      "proxy": "proxy_primary"
    }
  },
  "routing": {
    "rules": [
      {
        "match": "source_ip(set:chinaip)",
        "action": "direct"
      },
      {
        "match": "target_domain(set:chinadomain)",
        "action": "direct"
      },
      {
        "match": "dport(22)",
        "action": "direct"
      },
      {
        "match": "dport(80,443)",
        "action": "proxy(proxy_primary)"
      },
      {
        "match": "l4proto(tcp)",
        "action": "proxy(proxy_primary)"
      }
    ],
    "fallback": "proxy(proxy_primary)"
  },
  "dns": {
    "listen_addr": "169.254.0.1:53",
    "proxy_dns_servers": [
      "8.8.8.8:53",
      "1.1.1.1:53"
    ],
    "direct_dns_servers": [],
    "direct_use_system_dns": true,
    "query_timeout_ms": 5000,
    "enable_cache": true
  }
}
